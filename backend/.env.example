# Relative paths below are relative to the project root (the folder containing backend/).
# ---- Database ----
DATABASE_URL=postgresql+asyncpg://chess:chess@localhost:5432/chess_robot

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# ---- Password reset email ----
# Leave SMTP_HOST empty in development: reset codes are logged to the server console instead.
PASSWORD_RESET_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=Robot Chess <no-reply@example.com>

# ---- Engine ----
STOCKFISH_PATH=stockfish/stockfish
ANALYSIS_TIME_SEC=0.2

# ---- Vision ----
# YOLO weights: fixed in vision/map_pieces_to_squares.py (MODEL_PATH)
CALIBRATION_PATH=backend/data/calibration.json
DETECTION_MIN_CONFIDENCE=0.6
CAMERA_CAPTURE_TIMEOUT_SEC=20

# ---- Arm ----
# mock | serial
ARM_MODE=mock
ARM_SERIAL_PORT=/dev/cu.usbserial-2130
ARM_BAUD_RATE=115200
ARM_COMMAND_TIMEOUT_SEC=30
ARM_ANGLES_PATH=controller/angles_dict.json
# Seconds the mock arm "takes" per pick/place command
ARM_MOCK_DELAY_SEC=0.3

# ---- Dev ----
# Enables POST /games/{id}/debug/human-move (submit a UCI move without the camera)
DEBUG_ENDPOINTS=false
