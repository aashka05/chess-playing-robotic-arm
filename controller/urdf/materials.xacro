<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="gray">
        <color rgba="0.6 0.6 0.6 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.4 1.0 1"/>
    </material>

    <material name="red">
        <color rgba="0.9 0.2 0.2 1"/>
    </material>

    <material name="green">
        <color rgba="0.2 0.8 0.2 1"/>
    </material>

    <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
    </material>

    <material name="aluminium">
        <color rgba="0.78 0.78 0.80 1"/>
    </material>

</robot>