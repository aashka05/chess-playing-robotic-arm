<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro
      name="box_link"
      params="
        name
        size_x
        size_y
        size_z
        origin_x
        origin_y
        origin_z
        mass
        color">

    <link name="${name}">

      <!-- Visual -->

      <visual>
        <origin xyz="${origin_x} ${origin_y} ${origin_z}"/>
        <geometry>
            <box size="${size_x} ${size_y} ${size_z}"/>
        </geometry>
        <material name="${color}"/>
      </visual>

      <!-- Collision -->

      <collision>
        <origin xyz="${origin_x} ${origin_y} ${origin_z}"/>
        <geometry>
            <box size="${size_x} ${size_y} ${size_z}"/>
        </geometry>
      </collision>

      <!-- Inertial -->

      <inertial>
        <origin xyz="${origin_x} ${origin_y} ${origin_z}"/>
        <mass value="${mass}"/>
        <!-- Approximate inertia for a box -->
        <inertia
            ixx="${mass*(size_y*size_y+size_z*size_z)/12}"
            ixy="0"
            ixz="0"
            iyy="${mass*(size_x*size_x+size_z*size_z)/12}"
            iyz="0"
            izz="${mass*(size_x*size_x+size_y*size_y)/12}"/>
      </inertial>

    </link>

  </xacro:macro>

</robot>