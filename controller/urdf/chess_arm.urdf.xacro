<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="chess_arm">

    <xacro:include filename="$(find chess_description)/urdf/materials.xacro"/>
    <xacro:include filename="$(find chess_description)/urdf/dimensions.xacro"/>
    <xacro:include filename="$(find chess_description)/urdf/macros/plate.xacro"/>
    <xacro:include filename="$(find chess_description)/urdf/macros/box_link.xacro"/>
    <xacro:include filename="$(find chess_description)/urdf/links.xacro"/>
    <xacro:include filename="$(find chess_description)/urdf/joints.xacro"/>
</robot>